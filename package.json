{
  "name": "insane-forms",
  "type": "module",
  "version": "0.1.0",
  "description": "Schema-driven React forms on plain Zod: the schema is the form.",
  "author": "Daniel Kantor",
  "license": "MIT",
  "homepage": "https://github.com/kantord/insane-forms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kantord/insane-forms.git"
  },
  "bugs": {
    "url": "https://github.com/kantord/insane-forms/issues"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "play": "vite",
    "build:docs": "vite build",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build -o playground/dist/storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:docs && pnpm run build:storybook && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "build": "tsdown",
    "check:package": "publint && attw --pack . --profile esm-only",
    "ci": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "react-hook-form": "^7.50.0",
    "zod": "^4.4.0"
  },
  "sideEffects": false,
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@base-ui/react": "^1.5.0",
    "@biomejs/biome": "^2.4.16",
    "@fontsource-variable/geist": "^5.2.9",
    "@hookform/resolvers": "^5.4.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.17.0",
    "playwright": "^1.60.0",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "shadcn": "^4.10.0",
    "storybook": "^10.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
