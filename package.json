{
  "name": "insane-forms-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "vendor": "pnpm run vendor:ui && pnpm run vendor:registry && pnpm run format",
    "vendor:ui": "pnpm --filter @insane-forms/ui run vendor",
    "vendor:registry": "curl -fsS https://ui.shadcn.com/r/index.json -o apps/storybook/.storybook/shadcn-registry.json",
    "play": "pnpm --filter @insane-forms/landing run play",
    "build:docs": "pnpm --filter @insane-forms/landing run build",
    "storybook": "pnpm --filter @insane-forms/storybook run storybook",
    "build:storybook": "pnpm --filter @insane-forms/storybook run build:storybook",
    "test": "vitest run && pnpm --filter @insane-forms/storybook run test",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:docs && pnpm run build:storybook && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm --filter insane-forms run build",
    "check:package": "pnpm --filter insane-forms run check:package",
    "ci": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package",
    "analyze": "pnpm --filter @insane-forms/landing run analyze",
    "perf": "lhci autorun",
    "measure": "pnpm --filter insane-forms run measure",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@base-ui/react": "^1.5.0",
    "@biomejs/biome": "^2.4.16",
    "@capsizecss/metrics": "^4.0.0",
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/spline-sans-mono": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@shikijs/magic-move": "^4.2.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-form": "^1.33.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "input-otp": "^1.4.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.8.9",
    "playwright": "^1.60.0",
    "publint": "^0.3.21",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "shadcn": "^4.10.0",
    "shiki": "^4.2.0",
    "sonner": "^2.0.7",
    "storybook": "^10.4.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
